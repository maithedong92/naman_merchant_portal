# ==============================================================================
# Nam An Market - Unified Merchant Portal (NAM-UMP) Environment Config
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True
APP_NAME="Nam An Merchant Portal"
APP_VERSION="1.0.0"
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","https://portal.namanmarket.com"]

# PostgreSQL Database Configuration
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/naman_merchant_portal
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# ShopeeFood Partner API (Foody Partner Integration)
SHOPEEFOOD_ENABLED=True
SHOPEEFOOD_APP_ID=10045
SHOPEEFOOD_APP_KEY=a9756768d72268a6d66ea886031988f0638f03b0036fc63fbe0b86a6aef18546
SHOPEEFOOD_BASE_URL=https://gexternalapi.deliverynow.vn
SHOPEEFOOD_COUNTRY=VN
SHOPEEFOOD_LANGUAGE=vi

# GrabMart Partner API (Grab POS Integration)
GRABMART_ENABLED=True
GRABMART_CLIENT_ID=your_grab_client_id_here
GRABMART_CLIENT_SECRET=your_grab_client_secret_here
GRABMART_BASE_URL=https://partner-api.grab.com
GRABMART_SCOPE=grabmart.partner.pos
GRABMART_COUNTRY=VN
GRABMART_CURRENCY=VND

# Shopee Open Platform (E-Commerce)
SHOPEE_ENABLED=False
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_BASE_URL=https://partner.shopeemobile.com

# Core Security / Webhook Secrets
INTERNAL_API_SECRET=naman_secure_internal_secret_change_me
WEBHOOK_TIMEOUT_SECONDS=15
