# ==============================================================================
# Nam An Market - Unified Merchant Portal (NAM-UMP) Environment Config
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=False
APP_NAME="Nam An Merchant Portal"
APP_VERSION="1.0.0"
HOST=0.0.0.0
PORT=3002
PUBLIC_BASE_URL=https://ump.namanmarket.com
# Production default restricts CORS/CSRF to HTTPS portal origin; override in local dev .env if needed:
# ALLOWED_ORIGINS=["http://localhost:3001","http://localhost:3002","http://localhost:3003"]
ALLOWED_ORIGINS=["https://ump.namanmarket.com"]
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128","172.16.0.0/12"]

# PostgreSQL Database Configuration (UMP Database)
# For remote/production PostgreSQL over TLS with asyncpg, append ?ssl=require (or ssl=verify-full)
DATABASE_URL=postgresql+asyncpg://ump_admin:CHANGE_ME_DB_PASSWORD@host.docker.internal:6767/ump?ssl=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False


# ShopeeFood Partner API (Foody Partner Integration)
SHOPEEFOOD_ENABLED=True
SHOPEEFOOD_APP_ID=your_shopeefood_app_id
SHOPEEFOOD_APP_KEY=your_shopeefood_app_key
SHOPEEFOOD_BASE_URL=https://gexternalapi.deliverynow.vn
SHOPEEFOOD_COUNTRY=VN
SHOPEEFOOD_LANGUAGE=vi
SHOPEEFOOD_MENU_USERNAME=your_shopeefood_menu_user
SHOPEEFOOD_MENU_PASSWORD=your_shopeefood_menu_password

# GrabMart Partner API (Grab POS Integration)
GRABMART_ENABLED=True
GRABMART_CLIENT_ID=your_grab_client_id_here
GRABMART_CLIENT_SECRET=your_grab_client_secret_here
GRABMART_PARTNER_CLIENT_ID=naman_grabmart_pos
GRABMART_PARTNER_CLIENT_SECRET=your_grab_partner_client_secret_here
GRABMART_INBOUND_BEARER_TOKEN=your_grab_inbound_bearer_token_here
GRABMART_OAUTH_URL=https://api.grab.com/grabid/v1/oauth2/token
GRABMART_BASE_URL=https://partner-api.grab.com
GRABMART_SCOPE=mart.partner_api
GRABMART_COUNTRY=VN
GRABMART_CURRENCY=VND

# ShopeeMart / Shopee Open Platform API v2 (Shopee Supermarket / Fresh)
SHOPEEMART_ENABLED=True
SHOPEEMART_PARTNER_ID=your_shopee_partner_id
SHOPEEMART_PARTNER_KEY=your_shopee_partner_key
SHOPEEMART_SHOP_ID=your_shopee_shop_id
SHOPEEMART_BASE_URL=https://partner.shopeemobile.com

# Core Security, JWT & Authentication
INTERNAL_API_SECRET=CHANGE_ME_RANDOM_32_BYTES
WEBHOOK_TIMEOUT_SECONDS=15
JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_BYTES_JWT_SECRET
# Symmetric Fernet/base64 encryption key for stored secrets/tokens (generate via:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRETS_ENCRYPTION_KEY=CHANGE_ME_FERNET_32_BYTE_BASE64_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Default Initial SuperAdmin Credentials (seeded automatically on first run if password set)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
INITIAL_ADMIN_EMAIL=admin@namanmarket.com
INITIAL_ADMIN_FULL_NAME="Nam An System Administrator"

# Poppies ERP & Haravan / MongoDB
# For production MongoDB over TLS, append tls=true&tlsCAFile=/path/to/ca.pem (never tlsAllowInvalidCertificates=true)
MONGO_URI=mongodb://user:CHANGE_ME@host.docker.internal:27011/?authSource=pmdonhang&tls=true
MONGO_DB=pmdonhang
MONGO_ORDERS_COLLECTION=donhang
ARITO_DB=arito_database
ARITO_INVENTORY_COLLECTION=cttk

AUTH_MONGO_ENABLED=True
AUTH_MONGO_URI=mongodb://adminuser:CHANGE_ME@host.docker.internal:27011/?tls=true
AUTH_MONGO_DB=naman_internal_app
AUTH_MONGO_COLLECTION=user

HARAVAN_ENABLED=True
HARAVAN_TOKEN=your_haravan_token_here
HARAVAN_BASE_URL=https://apis.haravan.com/com
HARAVAN_SYNC_INTERVAL_SECONDS=60
HARAVAN_SYNC_LIMIT=100

POPPIES_API_BASE_URL=http://host.docker.internal:6515/api/v1/pos/master-data
POPPIES_PRICING_BASE_URL=http://host.docker.internal:6515/api/v1/pricing
POPPIES_POS_PRICING_BASE_URL=http://host.docker.internal:6515/api/v1/pos/pricing
POPPIES_API_KEY=your_poppies_api_key_here
POPPIES_WEBHOOK_KEY=your_poppies_webhook_key_here
POPPIES_TIMEOUT_SECONDS=120.0
POPPIES_SYNC_ENABLED=True
POPPIES_SYNC_INTERVAL_SECONDS=300
